# Grant the logged-in user write access to the keyboard LED control file
# so colour changes never require root or pkexec.
SUBSYSTEM=="leds", KERNEL=="casper::kbd_backlight", RUN+="/usr/bin/chgrp video /sys/class/leds/casper::kbd_backlight/led_control", RUN+="/usr/bin/chmod 0660 /sys/class/leds/casper::kbd_backlight/led_control"
